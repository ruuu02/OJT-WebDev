PP_NAME=Ultrafood

# ──────────────────────────────────────────────────────────────────────
# ADMIN CREDENTIALS (used by AdminUserSeeder — php artisan db:seed)
# ──────────────────────────────────────────────────────────────────────
ADMIN_NAME="Super Admin"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ──────────────────────────────────────────────────────────────────────
# DATABASE
# ──────────────────────────────────────────────────────────────────────
# Local (XAMPP/Laragon):
#   DB_HOST=127.0.0.1
#   DB_DATABASE=ultrafood          ← create this in phpMyAdmin first
#   DB_USERNAME=root
#   DB_PASSWORD=                   ← blank by default in XAMPP
#
# Hostinger (production):
#   DB_HOST=127.0.0.1              ← always 127.0.0.1 on shared hosting
#   DB_DATABASE=u123456_dbname     ← from hPanel → MySQL Databases
#   DB_USERNAME=u123456_username   ← from hPanel → MySQL Databases
#   DB_PASSWORD=your_db_password   ← the password you set in hPanel
#
# Shared DB (two laptops — same data everywhere):
#   Use ONE MySQL server both machines can reach (Hostinger Remote MySQL,
#   Railway, Aiven, etc.). Set identical DB_* on laptop A and B.
#   See docs/SHARED_DATABASE.md
# ──────────────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

# ──────────────────────────────────────────────────────────────────────
# MAIL / EMAIL ALERTS
# ──────────────────────────────────────────────────────────────────────
# Local dev: set MAIL_MAILER=log — emails are written to storage/logs/laravel.log
#
# Hostinger (production) — use Hostinger Email SMTP:
#   MAIL_MAILER=smtp
#   MAIL_HOST=smtp.hostinger.com
#   MAIL_PORT=465
#   MAIL_SCHEME=ssl
#   MAIL_USERNAME=security@yourdomain.com   ← email you created in hPanel
#   MAIL_PASSWORD=your_email_password       ← the password you set in hPanel
#   MAIL_FROM_ADDRESS=security@yourdomain.com
#   MAIL_FROM_NAME="Ultrafood Security"
#   MAIL_NOTIFY_TO=your-personal@email.com  ← where you want alerts sent
#
# Gmail SMTP alternative (use App Password, not your real Gmail password):
#   MAIL_MAILER=smtp
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_SCHEME=tls
#   MAIL_USERNAME=your@gmail.com
#   MAIL_PASSWORD=your_app_password         ← from Google > Security > App Passwords
#   MAIL_FROM_ADDRESS=your@gmail.com
#   MAIL_FROM_NAME="Ultrafood Security"
#   MAIL_NOTIFY_TO=your@gmail.com
# ──────────────────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="security@yourdomain.com"
MAIL_FROM_NAME="Ultrafood Security"
MAIL_NOTIFY_TO="your-personal@email.com"

VITE_APP_NAME="${APP_NAME}"