{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "/favicon.ico",
      "dest": "/public/favicon.ico"
    },
    {
      "src": "/robots.txt",
      "dest": "/public/robots.txt"
    },
    {
      "src": "/(css|js|images|videos|build)/(.*)",
      "dest": "/public/$1/$2"
    },
    {
      "src": "/(.*\\.(?:css|js|png|jpg|jpeg|gif|svg|ico|webp|avif|mp4|webm|woff|woff2|ttf|eot|pdf|txt))",
      "dest": "/public/$1"
    },
    {
      "src": "/",
      "dest": "/public/static/index.html"
    },
    {
      "src": "/(.+)/",
      "dest": "/public/static/$1/index.html"
    },
    {
      "src": "/(.+)",
      "dest": "/public/static/$1/index.html"
    }
  ]
}
